<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Ejercicio 7 — Ficha con Estructura</title>
</head>
<body>
    <h1>Ficha del Libro (Objeto)</h1>
    <div>
        <h2><%= libro.titulo %></h2>
        <p><strong>Autor:</strong> <%= libro.autor %></p>
        <p><strong>Precio (IVA incl.):</strong> <%= precioConIVA %> €</p>
        <p><strong>Estado:</strong> <%= estadoText %></p>
    </div>
</body>
</html>