<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Ejercicio 4 - Catálogo</title>
</head>
<body>
    <%- include("ej4_menu") %>

    <h1>Catálogo</h1>

    <% if (mensaje !== "") { %>
        <p><%= mensaje %></p>
    <% } %>

    <% for (let i = 0; i < libros.length; i++) { %>
        <div>
            <h2><%= libros[i].titulo %></h2>
            <p>Autor: <%= libros[i].autor %></p>
            <form action="/ra4/ej4/catalogo" method="post">
                <input type="hidden" name="titulo" value="<%= libros[i].titulo %>">
                <button type="submit">Apartar</button>
            </form>
        </div>
    <% } %>
</body>
</html>