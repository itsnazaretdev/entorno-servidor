<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Ejercicio 8 - Panel de gestión</title>
</head>
<body>
    <h1>Panel de gestión de libros</h1>
    <p>Hola, <%= usuario %> (admin)</p>

    <ul>
        <% for (let i = 0; i < libros.length; i++) { %>
            <li>
                <%= libros[i].titulo %> -
                <%= libros[i].precioBase %> €
            </li>
        <% } %>
    </ul>

    <a href="/ra4/ej5_login">Volver</a>
</body>
</html>