<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Ejercicio 7 - Mi bolsa</title>
</head>
<body>
    <h1>Mi bolsa de préstamos</h1>
    <p>Hola, <%= usuario %></p>

    <% if (bolsa.length === 0) { %>
        <p>Tu bolsa está vacía.</p>
    <% } else { %>
        <ul>
            <% for (let i = 0; i < bolsa.length; i++) { %>
                <li><%= bolsa[i] %></li>
            <% } %>
        </ul>
    <% } %>

    <a href="/ra4/ej5_login">Volver</a>
</body>
</html>