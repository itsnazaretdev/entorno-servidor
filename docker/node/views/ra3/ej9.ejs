<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>Buscar libros</h1>

<form action="/ra3/ej9" method="get">
    <label for="busqueda">Título:</label>
    <input type="text" id="busqueda" name="busqueda" value="<%= busqueda %>">

    <label for="genero">Género:</label>
    <select id="genero" name="genero">
        <option value="">Todos</option>
        <option value="Fantasía">Fantasía</option>
        <option value="Distopía">Distopía</option>
        <option value="Ciencia ficción">Ciencia ficción</option>
    </select>

    <button type="submit">Buscar</button>
</form>

    <% for (let i = 0; i < resultados.length; i++) { %>
        <div>
            <h2><%= resultados[i].titulo %></h2>
            <p>Autor: <%= resultados[i].autor %></p>
            <p>Género: <%= resultados[i].genero %></p>
        </div>
    <% } %>
</body>
</html>