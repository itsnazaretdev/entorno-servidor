<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Ejercicio 2 - Clase Libro</title>
</head>
<body>
    <h1>Catálogo</h1>

    <% for (let i = 0; i < libros.length; i++) { %>
        <div>
            <h2><%= libros[i].titulo %></h2>
            <p>Autor: <%= libros[i].autor %></p>
            <p>Precio con IVA: <%= libros[i].precioConIva() %> €</p>

            <% if (libros[i].estaDisponible()) { %>
                <p>Disponible</p>
            <% } else { %>
                <p>Agotado</p>
            <% } %>
        </div>
    <% } %>
</body>
</html>