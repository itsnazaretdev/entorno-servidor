
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Ejercicio 3 - Repository</title>
</head>
<body>
    <h1>Catálogo</h1>

    <form action="/ra5/ej3" method="get">
        <label for="busqueda">Título:</label>
        <input type="text" id="busqueda" name="busqueda" value="<%= busqueda %>">
        <button type="submit">Buscar</button>
    </form>

    <% if (busqueda !== "") { %>
        <p>Resultados para: <%= busqueda %></p>
    <% } %>

    <% if (resultados.length === 0) { %>
        <p>No se encontraron libros.</p>
    <% } else { %>
        <% for (let i = 0; i < resultados.length; i++) { %>
            <div>
                <h2><%= resultados[i].titulo %></h2>
                <p>Autor: <%= resultados[i].autor %></p>
                <p>Precio con IVA: <%= resultados[i].precioConIva() %> €</p>

                <% if (resultados[i].estaDisponible()) { %>
                    <p>Disponible</p>
                <% } else { %>
                    <p>Agotado</p>
                <% } %>
            </div>
        <% } %>
    <% } %>
</body>
</html>