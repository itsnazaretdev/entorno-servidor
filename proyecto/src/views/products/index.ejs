<%- include('../partials/head') %>
<%- include('../partials/header') %>

<section class="hero">
  <h1>Catálogo</h1>
  <p>Todos los productos de la tienda. También los tienes en JSON en <a href="/api" class="mono">/api</a>.</p>
</section>

<% if (products.length === 0) { %>
  <p class="empty">Todavía no hay productos.</p>
<% } else { %>
  <div class="grid">
    <% products.forEach((product, index) => { %>
      <a href="/productos/<%= product.id %>" class="card tint-<%= index % 4 %>">
        <div class="card-image">
          <img src="<%= product.image_url || '/img/placeholder.svg' %>" alt="<%= product.name %>" loading="lazy">
        </div>
        <div class="card-body">
          <h2><%= product.name %></h2>
          <p class="price"><%= product.price.toFixed(2).replace('.', ',') %> €</p>
          <p class="stock <%= product.stock === 0 ? 'out' : '' %>">
            <%= product.stock > 0 ? product.stock + ' en stock' : 'Agotado' %>
          </p>
        </div>
      </a>
    <% }) %>
  </div>
<% } %>

<%- include('../partials/footer') %>
