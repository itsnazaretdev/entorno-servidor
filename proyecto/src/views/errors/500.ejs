<%- include('../partials/head') %>
<%- include('../partials/header') %>

<section class="error-page">
  <p class="error-code">500</p>
  <h1>Algo ha fallado</h1>
  <p class="muted">Ha ocurrido un error en el servidor. Prueba de nuevo en un momento.</p>
