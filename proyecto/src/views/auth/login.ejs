<%- include('../partials/head') %>
<%- include('../partials/header') %>

<section class="auth-box">
  <h1>Iniciar sesión</h1>
  <p class="muted">Accede al panel para gestionar los productos.</p>

  <%- include('../partials/form-errors') %>

  <form action="/login" method="POST" class="form" novalidate>
    <label for="email">Email</label>
    <input type="email" id="email" name="email" value="<%= old.email || '' %>" autocomplete="email" required>

    <label for="password">Contraseña</label>
    <input type="password" id="password" name="password" autocomplete="current-password" required>

    <button type="submit" class="btn btn-full">Entrar</button>
  </form>

  <p class="muted small">¿No tienes cuenta? <a href="/register">Regístrate</a></p>
</section>

<%- include('../partials/footer') %>
