<%- include('../partials/head') %>
<%- include('../partials/header') %>

<a href="/admin" class="back">← Volver al panel</a>

<section class="form-box">
  <h1><%= isEdit ? 'Editar producto' : 'Nuevo producto' %></h1>

  <%- include('../partials/form-errors') %>

  <form action="<%= isEdit ? '/admin/productos/' + product.id + '?_method=PUT' : '/admin/productos' %>"
        method="POST" class="form" novalidate>

    <label for="name">Nombre</label>
    <input type="text" id="name" name="name" maxlength="100" value="<%= product.name || '' %>" required>

    <label for="description">Descripción</label>
    <textarea id="description" name="description" rows="3"><%= product.description || '' %></textarea>

    <div class="form-row">
      <div>
        <label for="price">Precio (€)</label>
        <input type="number" id="price" name="price" min="0" step="0.01" value="<%= product.price ?? '' %>" required>
      </div>
      <div>
        <label for="stock">Stock</label>
        <input type="number" id="stock" name="stock" min="0" step="1" value="<%= product.stock ?? 0 %>">
      </div>
    </div>

    <label for="image_url">Imagen <span class="hint">(ruta, p. ej. /img/teclado.svg)</span></label>
    <input type="text" id="image_url" name="image_url" maxlength="255" value="<%= product.image_url || '' %>">

    <div class="form-actions">
      <a href="/admin" class="btn btn-soft">Cancelar</a>
      <button type="submit" class="btn"><%= isEdit ? 'Guardar cambios' : 'Crear producto' %></button>
    </div>
  </form>
</section>

<%- include('../partials/footer') %>
