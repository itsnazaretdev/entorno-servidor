git# Copia este archivo como .env y cambia los valores

PORT=3000
NODE_ENV=development

# Dentro de Docker se sobrescribe a "db". Fuera de Docker usa localhost
DB_HOST=localhost
DB_PORT=5432
DB_USER=productos_user
DB_PASSWORD=cambiar_esto
DB_NAME=productos_db

# Cadena larga y aleatoria, por ejemplo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=cambiar_por_una_cadena_larga_y_aleatoria

# Pon true solo si la web se sirve con HTTPS. En localhost déjalo en false
COOKIE_SECURE=false
